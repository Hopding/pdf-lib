# JPEG dictionary for fuzzing
# JPEG markers (using hex)
"\xff\xd8"
"\xff\xd9"
"\xff\xe0"
"\xff\xe1"
"\xff\xdb"
"\xff\xc0"
"\xff\xc2"
"\xff\xc4"
"\xff\xda"
"\xff\xdd"
"\xff\xfe"

# JFIF header
"JFIF\x00"

# EXIF header
"Exif\x00\x00"

# APP segments
"\xff\xe0\x00\x10"
"\xff\xe1\x00\x08"

# Common segment lengths
"\x00\x02"
"\x00\x04"
"\x00\x08"
"\x00\x10"
"\x00\x40"
"\x00\x80"

# SOF markers
"\xff\xc0"
"\xff\xc1"
"\xff\xc2"
"\xff\xc3"

# Huffman table marker
"\xff\xc4"

# Quantization table marker
"\xff\xdb"

# SOS marker
"\xff\xda"

# RST markers
"\xff\xd0"
"\xff\xd1"
"\xff\xd2"
"\xff\xd3"
"\xff\xd4"
"\xff\xd5"
"\xff\xd6"
"\xff\xd7"

# Common dimensions
"\x00\x01"
"\x00\x64"
"\x01\x00"
"\x02\x00"
"\x04\x00"

# Bits per sample
"\x08"
"\x0c"

# Number of components
"\x01"
"\x03"
"\x04"
