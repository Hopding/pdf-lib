"PLTE"
"IDAT"
"IEND"

# Ancillary chunks
"cHRM"
"gAMA"
"iCCP"
"sBIT"
"sRGB"
"bKGD"
"hIST"
"tRNS"
"pHYs"
"sPLT"
"tIME"
"iTXt"
"tEXt"
"zTXt"

